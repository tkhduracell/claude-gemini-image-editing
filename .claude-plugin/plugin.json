{
  "name": "nb2lite-image",
  "description": "Generate and edit images with Google's gemini-3.1-flash-lite-image (NB2Lite) via the stateful Interactions API: text-to-image, multi-turn stateful edits, and local-image editing through the nb2lite-agent MCP server.",
  "version": "0.2.0",
  "author": {
    "name": "tkhduracell",
    "url": "https://github.com/tkhduracell"
  },
  "homepage": "https://github.com/tkhduracell/nb2lite-skill-claude",
  "repository": "https://github.com/tkhduracell/nb2lite-skill-claude",
  "license": "Apache-2.0",
  "keywords": ["gemini", "image-generation", "nb2lite", "mcp", "interactions-api"],
  "mcpServers": {
    "nb2lite-agent": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GEMINI_API_KEY",
        "-e",
        "GEMINI_MODEL_NAME",
        "-e",
        "HOST_OUTPUT_DIR",
        "-v",
        "${CLAUDE_PROJECT_DIR}/images:/images",
        "tkhduracell/nb2lite-agent:0.2.0"
      ]
    }
  }
}
